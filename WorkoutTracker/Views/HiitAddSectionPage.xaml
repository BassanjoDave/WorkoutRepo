<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.HiitAddSectionPage"
             x:DataType="vm:HiitBuilderViewModel"
             Title="Add Section">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Add section" Style="{StaticResource MetaLabel}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Type" Style="{StaticResource MetaLabel}" FontSize="10" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding SectionTypes}" SelectedItem="{Binding NewSectionType}" TextColor="{StaticResource ColorText}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Label (optional)" Style="{StaticResource MetaLabel}" FontSize="10" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding NewSectionTitle}" Placeholder="e.g. Burpees — leave blank to just say the type" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Description (optional)" Style="{StaticResource MetaLabel}" FontSize="10" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding NewSectionDescription}" Placeholder="Shown during the countdown" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Duration (seconds)" Style="{StaticResource MetaLabel}" FontSize="10" />
                            <Border Style="{StaticResource InputBorder}">
                                <Entry Text="{Binding NewSectionSeconds}" Keyboard="Numeric" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Add" Style="{StaticResource PrimaryOutlineButton}" Command="{Binding AddSectionCommand}" VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="OR" Style="{StaticResource KickerLabel}" HorizontalOptions="Center" />

            <Border Style="{StaticResource CardBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBrowseExercisesTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Browse Exercises" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{StaticResource IconCaretRight}" FontFamily="{StaticResource FontPhosphorRegular}"
                           TextColor="{StaticResource ColorNeutral500}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddFromRitualTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Add From an Existing Ritual" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{StaticResource IconCaretRight}" FontFamily="{StaticResource FontPhosphorRegular}"
                           TextColor="{StaticResource ColorNeutral500}" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
