<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.FoodLibraryPage"
             x:DataType="vm:FoodLibraryViewModel"
             Title="Food Library">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <Button Text="‹ Back" Style="{StaticResource GhostButton}" FontSize="12"
                    Command="{Binding BackCommand}" HorizontalOptions="Start" />

            <Border Style="{StaticResource InputBorder}">
                <Entry Text="{Binding SearchText}" Placeholder="Search foods…" FontSize="13" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="+ Add Food" Style="{StaticResource PrimaryOutlineButton}" FontSize="12" Command="{Binding AddFoodCommand}" />
                <Button Grid.Column="1" Text="Browse Recipes" Style="{StaticResource PrimaryOutlineButton}" FontSize="12" Command="{Binding OpenRecipesCommand}" />
            </Grid>

            <Label Text="FOODS" Style="{StaticResource KickerLabel}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Foods}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FoodRowViewModel">
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" />
                                    <Border Style="{StaticResource TagAccentBorder}" IsVisible="{Binding OwnerBadge, Converter={StaticResource StringToBoolConverter}}">
                                        <Label Text="{Binding OwnerBadge}" Style="{StaticResource TagAccentLabel}" FontSize="9" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding SubtitleLabel}" Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
