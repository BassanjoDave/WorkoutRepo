<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.NutritionSummaryView"
             x:DataType="vm:NutritionSummaryViewModel"
             IsVisible="{Binding HasAnySelected}">

    <Border Style="{StaticResource CardBorder}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand}" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="6">
            <Label Text="NUTRITION" Style="{StaticResource KickerLabel}" />

            <VerticalStackLayout Spacing="3" IsVisible="{Binding ShowCalories}">
                <Label Text="{Binding CaloriesLabel}" FontSize="13" />
                <ProgressBar Progress="{Binding CaloriesProgress}" ProgressColor="{StaticResource ColorAccent}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="3" IsVisible="{Binding ShowProtein}">
                <Label Text="{Binding ProteinLabel}" FontSize="12" Style="{StaticResource MetaLabel}" />
                <ProgressBar Progress="{Binding ProteinProgress}" ProgressColor="{StaticResource ColorAccent}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="3" IsVisible="{Binding ShowCarbs}">
                <Label Text="{Binding CarbsLabel}" FontSize="12" Style="{StaticResource MetaLabel}" />
                <ProgressBar Progress="{Binding CarbsProgress}" ProgressColor="{StaticResource ColorAccent}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="3" IsVisible="{Binding ShowFat}">
                <Label Text="{Binding FatLabel}" FontSize="12" Style="{StaticResource MetaLabel}" />
                <ProgressBar Progress="{Binding FatProgress}" ProgressColor="{StaticResource ColorAccent}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
