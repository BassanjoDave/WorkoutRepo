<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             xmlns:views="clr-namespace:WorkoutTracker.Views"
             x:Class="WorkoutTracker.Views.ExercisePage"
             x:DataType="vm:ExerciseViewModel"
             Title="Rituals">

    <ContentPage.Resources>
        <Style x:Key="ToggleChip" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource ColorDivider}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Shadow" Value="{StaticResource ShadowSm}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <views:AppTabBar ActiveRoute="exercise" />

            <Label Text="Rituals" Style="{StaticResource HeadingLabel}" />

            <!-- Rituals / Exercises toggle -->
            <HorizontalStackLayout Spacing="6">
                <Border Style="{StaticResource ToggleChip}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowWorkoutsCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsWorkoutsTab}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource ColorAccent}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Rituals" FontSize="12">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsWorkoutsTab}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource ToggleChip}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowLibraryCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsLibraryTab}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource ColorAccent}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Exercises" FontSize="12">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsLibraryTab}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </HorizontalStackLayout>

            <ContentView x:Name="WorkoutsHost" IsVisible="{Binding IsWorkoutsTab}" />
            <ContentView x:Name="LibraryHost" IsVisible="{Binding IsLibraryTab}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
