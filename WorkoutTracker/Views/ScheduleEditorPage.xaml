<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.ScheduleEditorPage"
             x:DataType="vm:ScheduleEditorViewModel"
             Title="My Schedule">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Label Text="Every routine with a recurring schedule. Tap one to change its time, recurrence, or reminder."
                   Style="{StaticResource MetaLabel}" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleOverviewRowViewModel">
                        <Border Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding RoutineName}" FontSize="14" FontAttributes="Bold" />
                                        <Border Style="{StaticResource TagAccentBorder}" IsVisible="{Binding IsHiit}">
                                            <Label Text="HIIT" Style="{StaticResource TagAccentLabel}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Summary}" Style="{StaticResource MetaLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{StaticResource IconCaretRight}" FontFamily="{StaticResource FontPhosphorRegular}"
                                       TextColor="{StaticResource ColorNeutral500}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="No routines are on a recurring schedule yet — set one up from a routine's own builder page."
                   Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" Margin="0,20"
                   IsVisible="{Binding IsEmpty}" />

            <Button Text="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
