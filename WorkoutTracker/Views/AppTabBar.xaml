<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTracker.Views.AppTabBar"
             x:Name="Root">

    <VerticalStackLayout Spacing="10">

        <!-- App header — the app logo, shown once per page above the tab row (not
             repeated inside each page's own banner — see HomePage.xaml's comment). -->
        <Border Style="{StaticResource LogoCardBorder}" Padding="10" HorizontalOptions="Fill">
            <Image Source="logo.png" HeightRequest="40" Aspect="AspectFit" HorizontalOptions="Fill" />
        </Border>

        <!-- Notification bell + member avatar — shown once here (not per-page) so they're
             reachable from anywhere, not just Home. Loaded imperatively in code-behind
             (LoadAsync, called from each host page's OnAppearing) since this ContentView
             has no ViewModel/BindingContext of its own. -->
        <Border StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{StaticResource ColorBanner}" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Grid Grid.Column="1" WidthRequest="26" HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBellTapped" />
                    </Grid.GestureRecognizers>
                    <Label Text="{StaticResource IconBell}" FontSize="18" TextColor="{StaticResource ColorBannerText}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border x:Name="UnreadBadge" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource ColorAccent}"
                            WidthRequest="16" HeightRequest="16" Padding="0"
                            HorizontalOptions="End" VerticalOptions="Start"
                            IsVisible="False">
                        <Label x:Name="UnreadBadgeLabel" FontSize="10" TextColor="White" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
                <Border Grid.Column="2" StrokeShape="RoundRectangle 15" Stroke="Transparent"
                        x:Name="AvatarBorder" WidthRequest="30" HeightRequest="30" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAvatarTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label x:Name="AvatarInitialLabel" Style="{StaticResource MetaLabel}"
                               TextColor="{StaticResource ColorBg}" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Image x:Name="AvatarPhotoImage" Aspect="AspectFill" IsVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--
          Replaces Shell's native TabBar chrome (hidden globally via the ContentPage
          style in Styles.xaml). On Windows, Shell's TabBar collapses tabs that don't
          fit the window width behind a "..." overflow menu instead of wrapping, which
          made whichever tab landed in that overflow effectively invisible/undiscoverable.
          A plain FlexLayout of buttons wraps onto a second row instead, so every tab
          stays visible and reachable regardless of window width.
        -->
        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
            <Button x:Name="HomeButton" Text="Home" CommandParameter="home" Clicked="OnTabClicked"
                    Style="{StaticResource TabBarButton}" Margin="0,0,8,6" />
            <Button x:Name="ExerciseButton" Text="Rituals" CommandParameter="exercise" Clicked="OnTabClicked"
                    Style="{StaticResource TabBarButton}" Margin="0,0,8,6" />
            <Button x:Name="NutritionButton" Text="Nutrition" CommandParameter="nutrition" Clicked="OnTabClicked"
                    Style="{StaticResource TabBarButton}" Margin="0,0,8,6" />
            <Button x:Name="HistoryButton" Text="History" CommandParameter="history" Clicked="OnTabClicked"
                    Style="{StaticResource TabBarButton}" Margin="0,0,8,6" />
            <Button x:Name="MeasurementsButton" Text="Measurements" CommandParameter="measurements" Clicked="OnTabClicked"
                    Style="{StaticResource TabBarButton}" Margin="0,0,8,6" />
            <Button x:Name="StacksButton" Text="Stacks" CommandParameter="stacks" Clicked="OnTabClicked"
                    Style="{StaticResource TabBarButton}" Margin="0,0,8,6" />
            <Button x:Name="ProfileButton" Text="Profile" CommandParameter="profile" Clicked="OnTabClicked"
                    Style="{StaticResource TabBarButton}" Margin="0,0,8,6" />
        </FlexLayout>
    </VerticalStackLayout>
</ContentView>
