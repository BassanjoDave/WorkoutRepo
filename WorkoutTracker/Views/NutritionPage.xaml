<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             xmlns:views="clr-namespace:WorkoutTracker.Views"
             x:Class="WorkoutTracker.Views.NutritionPage"
             x:DataType="vm:NutritionViewModel"
             Title="Nutrition">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <views:AppTabBar ActiveRoute="nutrition" />

            <Border Padding="14,10" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                    BackgroundColor="{StaticResource ColorAccent800}" IsVisible="{Binding HasFullAccess, Converter={StaticResource InvertedBoolConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenUpgradeCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Your history stays visible — add Full Access to log new entries" FontSize="13" TextColor="{StaticResource ColorAccent300}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Upgrade" FontSize="12" TextColor="{StaticResource ColorAccent300}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <Label Grid.Column="0" Text="{Binding DateLabel}" Style="{StaticResource HeadingLabel}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Foods" Style="{StaticResource GhostButton}" FontSize="12" Command="{Binding OpenFoodLibraryCommand}" />
                <Button Grid.Column="2" Text="Recipes" Style="{StaticResource GhostButton}" FontSize="12" Command="{Binding OpenRecipesCommand}" />
                <Button Grid.Column="3" Text="Goals" Style="{StaticResource GhostButton}" FontSize="12" Command="{Binding OpenMacroGoalsCommand}" />
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding CaloriesLabel}" FontSize="13" />
                        <ProgressBar Progress="{Binding CaloriesProgress}" ProgressColor="{StaticResource ColorAccent}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding ProteinLabel}" FontSize="12" Style="{StaticResource MetaLabel}" />
                        <ProgressBar Progress="{Binding ProteinProgress}" ProgressColor="{StaticResource ColorAccent}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding CarbsLabel}" FontSize="12" Style="{StaticResource MetaLabel}" />
                        <ProgressBar Progress="{Binding CarbsProgress}" ProgressColor="{StaticResource ColorAccent}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding FatLabel}" FontSize="12" Style="{StaticResource MetaLabel}" />
                        <ProgressBar Progress="{Binding FatProgress}" ProgressColor="{StaticResource ColorAccent}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding MealGroups}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MealGroupViewModel">
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding TotalsLabel}" Style="{StaticResource MetaLabel}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="+ Add" Style="{StaticResource GhostButton}" FontSize="12"
                                            IsVisible="{Binding CanAdd}"
                                            Command="{Binding AddCommand}" CommandParameter="{Binding MealType}" />
                                </Grid>

                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Entries}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LoggedEntryRowViewModel">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label FontSize="13">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Name}" />
                                                                <Span Text=" — " />
                                                                <Span Text="{Binding QuantityLabel}" TextColor="{StaticResource ColorNeutral500}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label Text="{Binding MacrosLabel}" Style="{StaticResource MetaLabel}" FontSize="10" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Text="{StaticResource IconTrash}" FontFamily="{StaticResource FontPhosphorRegular}"
                                                        Style="{StaticResource GhostButton}" FontSize="14"
                                                        SemanticProperties.Description="Remove food entry"
                                                        Command="{Binding RemoveCommand}" CommandParameter="{Binding .}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
