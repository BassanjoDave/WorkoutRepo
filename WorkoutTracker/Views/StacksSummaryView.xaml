<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.StacksSummaryView"
             x:DataType="vm:StacksSummaryViewModel">

    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasAnyToday}">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0" Text="STACKS" Style="{StaticResource KickerLabel}" VerticalOptions="Center" />
            </Grid>

            <!-- Each stack scheduled for today gets its own bordered slot, up to two —
                 the "+N" tile stands in for the rest rather than the card growing without
                 bound (see StacksSummaryViewModel.LoadAsync). -->
            <HorizontalStackLayout Spacing="8">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </HorizontalStackLayout.GestureRecognizers>

                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding VisibleSlots}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:StackSlotViewModel">
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource ColorDivider}" StrokeThickness="1"
                                    BackgroundColor="Transparent" Padding="10,8" WidthRequest="110">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TimeLabel}" Style="{StaticResource MetaLabel}" FontSize="11" />
                                    <Label Text="{Binding ItemsLabel}" FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource ColorDivider}" StrokeThickness="1"
                        BackgroundColor="Transparent" Padding="10,8" WidthRequest="50"
                        IsVisible="{Binding HasMore}">
                    <Label Text="{Binding MoreCount, StringFormat='+{0}'}" FontSize="16" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
