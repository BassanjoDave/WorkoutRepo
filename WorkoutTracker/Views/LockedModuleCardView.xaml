<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.LockedModuleCardView"
             x:DataType="vm:LockedModuleCardViewModel">

    <Border Style="{StaticResource CardBorder}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand}" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Title}" Style="{StaticResource KickerLabel}" />
            <Label Text="{Binding Message}" FontSize="12" Style="{StaticResource MetaLabel}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
