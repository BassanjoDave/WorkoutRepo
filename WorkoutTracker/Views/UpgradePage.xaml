<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.UpgradePage"
             x:DataType="vm:UpgradeViewModel"
             Title="Upgrade">

    <!-- Routes the native toolbar/hardware back action through BackCommand too —
         see its doc comment for why this can't be Shell's default relative pop. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding BackCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Button Text="‹ Back" Style="{StaticResource GhostButton}" FontSize="12"
                    Command="{Binding BackCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding ReasonLabel}" FontSize="18" FontAttributes="Bold" />
            <Label Text="Full Access is available now — the other plans below are a preview of pricing while billing for them is still being built."
                   Style="{StaticResource MetaLabel}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="No Ads" FontAttributes="Bold" FontSize="14" />
                    <Label Text="$1.99/mo · $15.99/yr — removes ads, Workouts page only, 1 seat" Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Full Access" FontAttributes="Bold" FontSize="14" />
                    <Label Text="$4.99/mo · $39.99/yr — ad-free access to every page, 1 seat" Style="{StaticResource MetaLabel}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Monthly — $4.99" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PurchaseFullAccessCommand}" CommandParameter="full_access_monthly"
                                IsEnabled="{Binding IsPurchasing, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Grid.Column="1" Text="Yearly — $39.99" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PurchaseFullAccessCommand}" CommandParameter="full_access_yearly"
                                IsEnabled="{Binding IsPurchasing, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nutrition unlock" FontAttributes="Bold" FontSize="14" />
                    <Label Text="$1.99/mo · $15.99/yr — Nutrition page + History tab* " Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Stacks unlock" FontAttributes="Bold" FontSize="14" />
                    <Label Text="$1.99/mo · $15.99/yr — Stacks page + History tab*" Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Measurements unlock" FontAttributes="Bold" FontSize="14" />
                    <Label Text="$1.99/mo · $15.99/yr — Measurements page*" Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="*Ad-free access to a page you unlock à la carte requires No Ads or Full Access — a page unlock by itself doesn't remove ads."
                   Style="{StaticResource MetaLabel}" FontSize="11" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Family plan" FontAttributes="Bold" FontSize="14" />
                    <Label Text="+$1.99/mo (+$15.99/yr) covers 4 total users, plus two more $1.99/mo blocks covering seats 5–8 and 9–12 (12 total max). Every family member gets the ad-free access to whichever pages the main account holder has unlocked."
                           Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding PurchaseStatus}" Style="{StaticResource MetaLabel}"
                   IsVisible="{Binding PurchaseStatus, Converter={StaticResource StringToBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsPurchasing}" IsVisible="{Binding IsPurchasing}" />

            <Button Text="Restore Purchases" Style="{StaticResource GhostButton}"
                    Command="{Binding RestorePurchasesCommand}"
                    IsEnabled="{Binding IsPurchasing, Converter={StaticResource InvertedBoolConverter}}" />

            <!-- Required by both app stores' subscription review guidelines: the
                 auto-renewal terms and Terms of Use/Privacy Policy links must be
                 reachable from the purchase screen itself, not just elsewhere in
                 the app. -->
            <Label Text="Subscriptions auto-renew unless canceled at least 24 hours before the end of the current period. Manage or cancel anytime in your Google Play or App Store account settings."
                   Style="{StaticResource MetaLabel}" FontSize="11" />
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Terms of Service" Style="{StaticResource MetaLabel}" FontSize="11" TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTermsCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="·" Style="{StaticResource MetaLabel}" FontSize="11" />
                <Label Text="Privacy Policy" Style="{StaticResource MetaLabel}" FontSize="11" TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Button Text="Other plans coming soon" Style="{StaticResource SecondaryButton}" IsEnabled="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
