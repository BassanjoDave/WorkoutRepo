<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.StacksPage"
             x:DataType="vm:StacksViewModel"
             Title="Stacks">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <ContentView x:Name="AppHeaderHost" />

            <Border Padding="14,10" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                    BackgroundColor="{StaticResource ColorAccent800}" IsVisible="{Binding HasFullAccess, Converter={StaticResource InvertedBoolConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenUpgradeCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Your history stays visible — add Full Access to log new entries" FontSize="13" TextColor="{StaticResource ColorAccent300}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Upgrade" FontSize="12" TextColor="{StaticResource ColorAccent300}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Supplements &amp; Medications" Style="{StaticResource HeadingLabel}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+ New Stack" Style="{StaticResource GhostButton}" FontSize="11"
                        IsVisible="{Binding HasFullAccess}" Command="{Binding AddStackCommand}" />
            </Grid>

            <Label Text="No stacks yet — tap “+ New Stack” to group the supplements or medications you take together at the same time."
                   Style="{StaticResource MetaLabel}" IsVisible="{Binding Stacks.Count, Converter={StaticResource IsZeroConverter}}" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Stacks}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:StackRowViewModel">
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                        <Label Style="{StaticResource MetaLabel}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding TimeLabel}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding DaysLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding ItemsSummary}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Edit" Style="{StaticResource GhostButton}" FontSize="12"
                                            Command="{Binding EditCommand}" CommandParameter="{Binding Id}" />
                                    <Button Grid.Column="2" Text="{StaticResource IconTrash}" FontFamily="{StaticResource FontPhosphorRegular}"
                                            Style="{StaticResource GhostButton}" SemanticProperties.Description="Delete stack"
                                            Command="{Binding DeleteCommand}" CommandParameter="{Binding Id}" />
                                </Grid>

                                <Button Text="{Binding TakenButtonText}"
                                        Style="{StaticResource PrimaryOutlineButton}" FontSize="12"
                                        Command="{Binding ToggleTakenCommand}" CommandParameter="{Binding Id}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
