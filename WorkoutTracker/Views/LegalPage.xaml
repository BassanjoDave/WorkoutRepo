<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.LegalPage"
             x:DataType="vm:LegalViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Label Text="{Binding PageTitle}" Style="{StaticResource HeadingLabel}" />
            <Label Text="{Binding Body}" Style="{StaticResource MetaLabel}" FontSize="13" LineHeight="1.4" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
