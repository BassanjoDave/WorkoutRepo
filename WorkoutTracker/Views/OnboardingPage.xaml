<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="24,50,24,30" RowSpacing="20">

        <Button Grid.Row="0" Text="Skip" Style="{StaticResource GhostButton}" FontSize="13"
                Command="{Binding FinishCommand}" HorizontalOptions="End" />

        <!-- Static brand mark above the carousel, unaffected by which slide is showing.
             Save the wordmark logo file as Resources/Images/logo.png for this to render —
             MAUI auto-includes anything dropped into Resources/Images. -->
        <Border Grid.Row="1" Style="{StaticResource LogoCardBorder}" Padding="16" HorizontalOptions="Fill">
            <Image Source="logo.png" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Center" />
        </Border>

        <CarouselView Grid.Row="2" ItemsSource="{Binding Slides}" Position="{Binding CurrentIndex, Mode=TwoWay}"
                      IndicatorView="SlideIndicator" VerticalOptions="Center">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:OnboardingSlide">
                    <VerticalStackLayout Spacing="16" VerticalOptions="Center" Padding="8,0">
                        <Label Text="{Binding Title}" Style="{StaticResource HeadingLabel}" FontSize="24" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Description}" Style="{StaticResource MetaLabel}" FontSize="15" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="SlideIndicator" Grid.Row="3" HorizontalOptions="Center"
                       IndicatorColor="{StaticResource ColorDivider}" SelectedIndicatorColor="{StaticResource ColorAccent}" />

        <Button Grid.Row="4" Text="Get Started"
                Style="{StaticResource AccentFilledButton}" Command="{Binding FinishCommand}"
                IsVisible="{Binding IsLastSlide}" />
    </Grid>
</ContentPage>
