<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.MeasurementsSummaryView"
             x:DataType="vm:MeasurementsSummaryViewModel">

    <ContentView.Resources>
        <Style x:Key="ToggleChip" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource ColorDivider}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Shadow" Value="{StaticResource ShadowSm}" />
        </Style>
    </ContentView.Resources>

    <Border Style="{StaticResource CardBorder}">
        <VerticalStackLayout Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0" Text="MEASUREMENTS" Style="{StaticResource KickerLabel}" VerticalOptions="Center" />
            </Grid>
            <Label Text="{Binding LatestLabel}" FontSize="13">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding RangeChips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricChipViewModel">
                        <Border Style="{StaticResource ToggleChip}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="{Binding Name}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource ColorAccent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Name}" FontSize="10">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <GraphicsView Drawable="{Binding TrendDrawable}" HeightRequest="80">
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>

            <Button Text="View Measurements" Style="{StaticResource SecondaryButton}" FontSize="12"
                    Command="{Binding OpenCommand}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
