<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.BrowseRigsPage"
             x:DataType="vm:BrowseRigsViewModel"
             Title="Add a Rig">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <Button Text="‹ Back" Style="{StaticResource GhostButton}" FontSize="12"
                    Command="{Binding BackCommand}" HorizontalOptions="Start" />

            <Label Text="Pick the machines you have access to." Style="{StaticResource MetaLabel}" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rigs}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowseRigRowViewModel">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding Manufacturer}" Style="{StaticResource MetaLabel}" />
                                    <Label Text="{Binding Description}" FontSize="12" IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Add" Style="{StaticResource PrimaryOutlineButton}" FontSize="11"
                                        Command="{Binding AddCommand}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
