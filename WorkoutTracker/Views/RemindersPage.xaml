<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.RemindersPage"
             x:DataType="vm:RemindersViewModel"
             Title="Workout Reminders">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18" Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Enable reminders" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding Enabled}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Master switch for every workout reminder. Set each workout's own reminder time, snooze, and repeat from its own create/edit screen — this just controls whether any of them actually fire."
                           Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="18">
            <Button Grid.Column="0" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="Save" Style="{StaticResource AccentFilledButton}" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
