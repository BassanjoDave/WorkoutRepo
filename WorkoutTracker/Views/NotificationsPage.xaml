<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <Button Text="‹ Back" Style="{StaticResource GhostButton}" FontSize="12"
                    Command="{Binding BackCommand}" HorizontalOptions="Start" />

            <Label Text="Notifications" Style="{StaticResource HeadingLabel}" />

            <Label Text="Nothing here yet." Style="{StaticResource MetaLabel}" IsVisible="{Binding IsEmpty}" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Notifications}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationRowViewModel">
                        <Border Style="{StaticResource CardBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Ellipse Grid.Column="0" Fill="{StaticResource ColorAccent}" WidthRequest="8" HeightRequest="8"
                                         VerticalOptions="Start" Margin="0,5,0,0" IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding Body}" FontSize="13" />
                                    <Label Text="{Binding TimeLabel}" Style="{StaticResource MetaLabel}" FontSize="10" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
