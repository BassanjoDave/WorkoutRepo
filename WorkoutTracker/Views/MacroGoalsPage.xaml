<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.MacroGoalsPage"
             x:DataType="vm:MacroGoalsViewModel"
             Title="Daily Macro Goals">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18" Spacing="14">
                <Label Text="Set your daily targets. The Nutrition tab tracks progress against these as you log meals."
                       Style="{StaticResource MetaLabel}" />
                <Label Text="Check any you'd like to see as a running total on the Home dashboard. None checked means no Nutrition card on Home."
                       Style="{StaticResource MetaLabel}" FontSize="10" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Calories" Style="{StaticResource MetaLabel}" />
                        <Border Style="{StaticResource InputBorder}"><Entry Text="{Binding Calories}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                        <Label Text="On Home" Style="{StaticResource MetaLabel}" FontSize="9" HorizontalTextAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowCaloriesOnHome}" Color="{StaticResource ColorAccent}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Protein (g)" Style="{StaticResource MetaLabel}" />
                        <Border Style="{StaticResource InputBorder}"><Entry Text="{Binding Protein}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                        <Label Text="On Home" Style="{StaticResource MetaLabel}" FontSize="9" HorizontalTextAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowProteinOnHome}" Color="{StaticResource ColorAccent}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Carbs (g)" Style="{StaticResource MetaLabel}" />
                        <Border Style="{StaticResource InputBorder}"><Entry Text="{Binding Carbs}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                        <Label Text="On Home" Style="{StaticResource MetaLabel}" FontSize="9" HorizontalTextAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowCarbsOnHome}" Color="{StaticResource ColorAccent}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Fat (g)" Style="{StaticResource MetaLabel}" />
                        <Border Style="{StaticResource InputBorder}"><Entry Text="{Binding Fat}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                        <Label Text="On Home" Style="{StaticResource MetaLabel}" FontSize="9" HorizontalTextAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowFatOnHome}" Color="{StaticResource ColorAccent}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Water (oz)" Style="{StaticResource MetaLabel}" />
                        <Border Style="{StaticResource InputBorder}"><Entry Text="{Binding Water}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                        <Label Text="On Home" Style="{StaticResource MetaLabel}" FontSize="9" HorizontalTextAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowWaterOnHome}" Color="{StaticResource ColorAccent}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="18">
            <Button Grid.Column="0" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="Save" Style="{StaticResource AccentFilledButton}" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
